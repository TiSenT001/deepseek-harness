{
  "name": "dsh-obsidian-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian-style vault workspace for DeepSeek Harness: wikilinks, backlinks, tags, properties, graph.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scaffold"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsdown --config tsdown.popout.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "regen:expected": "node --experimental-strip-types scripts/regen-expected.mjs",
    "bench:large": "node --experimental-strip-types scripts/pur-large-doc-bench.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "bench:vault": "node --experimental-strip-types scripts/vault-scale-bench.mjs",
    "bench:graph": "node --experimental-strip-types scripts/graph-scale-bench.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:check": "node scripts/release-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "mermaid": "11.17.2"
  },
  "author": "TiSenT001",
  "repository": {
    "type": "git",
    "url": "https://github.com/TiSenT001/deepseek-harness.git",
    "directory": "plugins/dsh-obsidian-vault"
  },
  "homepage": "https://github.com/TiSenT001/deepseek-harness/tree/master/plugins/dsh-obsidian-vault",
  "bugs": {
    "url": "https://github.com/TiSenT001/deepseek-harness/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "obsidian",
    "markdown",
    "vault",
    "wikilinks",
    "backlinks",
    "canvas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.9"
  }
}

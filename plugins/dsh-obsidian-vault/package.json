{
  "name": "dsh-obsidian-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian-style vault workspace for DeepSeek Harness: wikilinks, backlinks, tags, properties, graph.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsdown --config tsdown.popout.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "regen:goldens": "node --experimental-strip-types scripts/regen-goldens.mjs",
    "bench:large": "node --experimental-strip-types scripts/pur-large-doc-bench.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "bench:vault": "node --experimental-strip-types scripts/vault-scale-bench.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
